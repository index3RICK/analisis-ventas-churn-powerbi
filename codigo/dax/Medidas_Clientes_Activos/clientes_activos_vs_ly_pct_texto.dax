// ---------------------------------------------------------------------
// Medida : Clientes_Activos_vs_LY_%_texto
// Tabla  : Medidas_Clientes_Activos
// Paneles: 3   (1 Cuadro de mando, 2 Detalle de ventas, 3 Abandono, 4 Reactivación)
// Qué hace: Texto con flecha para la tarjeta de clientes activos.
// ---------------------------------------------------------------------

Clientes_Activos_vs_LY_%_texto =
VAR a      = [Clientes_Activos_vs_LY_%]
VAR flecha = IF(a >= 0, "🔺", "🔻")
RETURN
flecha & " " & FORMAT(ABS(a), "0.0%") & " vs PY"
