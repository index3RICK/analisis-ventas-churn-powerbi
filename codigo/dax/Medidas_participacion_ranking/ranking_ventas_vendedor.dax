// ---------------------------------------------------------------------
// Medida : ranking_ventas_vendedor
// Tabla  : Medidas_participacion_ranking
// Paneles: 2   (1 Cuadro de mando, 2 Detalle de ventas, 3 Abandono, 4 Reactivación)
// Qué hace: Posición de cada vendedor por ventas.
// ---------------------------------------------------------------------

ranking_ventas_vendedor =
RANKX(
    ALLSELECTED(Analisis_Ventas[Vendedor]),
    [ventas_totales],
    ,
    DESC
)
